# Contact form delivery, and the auto-reply the visitor receives.
#
# Until one of the two options below is set, the form does NOT send: it falls
# back to opening the visitor's own mail client. Set these in the Vercel project
# (Settings -> Environment Variables, then redeploy) to have messages delivered
# directly and the acknowledgement in src/content/auto-reply.ts sent back.
#
# Never commit real values — this file is the template only.


# --- Option A: SMTP, using a mailbox you already own -------------------------
#
# The quick path: no DNS changes, works with the existing rosica.ae email.
# Create an app password on the mailbox (Google Workspace: Account -> Security
# -> 2-Step Verification -> App passwords. Microsoft 365: an admin may need to
# switch on Authenticated SMTP for the account first).
#
#   Google Workspace   smtp.gmail.com        port 587
#   Microsoft 365      smtp.office365.com    port 587
#   Zoho               smtp.zoho.com         port 587
#
# Ask the provider if yours is not listed — "SMTP settings" is the search term.

SMTP_HOST=
SMTP_PORT=587
# The full mailbox address, e.g. info@rosica.ae
SMTP_USER=
# The app password, not the account's login password.
SMTP_PASSWORD=


# --- Option B: Resend, an HTTP mail API --------------------------------------
#
# Better suited to serverless, but needs DNS access: you have to add records to
# rosica.ae to verify the sending domain. Skip this if Option A is set — SMTP
# takes priority when both are present.
#
# 1. Create a free account at https://resend.com
# 2. Verify the rosica.ae domain there
# 3. Copy the API key into RESEND_API_KEY

RESEND_API_KEY=


# --- Both options ------------------------------------------------------------

# The address enquiries are sent FROM. With SMTP this defaults to SMTP_USER;
# with Resend it is required, and must be on the domain verified there.
CONTACT_FROM_EMAIL=
# Where enquiries land. Defaults to info@rosica.ae when unset.
CONTACT_TO_EMAIL=info@rosica.ae


# The Rosica assistant (the chat widget).
#
# Optional. Without it the launcher never appears — the site is unchanged, no
# broken button. With it, /api/chat answers visitors from a brief built out of
# the site's own content, so it cannot invent product or ingredient claims.
#
# Get a key at https://console.anthropic.com and set a spend limit while you
# are there; the widget is open to anyone who loads the page.

ANTHROPIC_API_KEY=
