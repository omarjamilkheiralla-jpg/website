# Contact form delivery, and the auto-reply the visitor receives.
#
# Without these the form still works: it falls back to opening the visitor's
# own mail client addressed to the inbox below. Set them in the Vercel project
# (Settings -> Environment Variables) to have messages delivered directly, and
# to have the acknowledgement in src/content/auto-reply.ts sent back.
#
# 1. Create a free account at https://resend.com
# 2. Verify the rosica.ae domain there
# 3. Copy the API key into RESEND_API_KEY
#
# Never commit real values — this file is the template only.

RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. website@rosica.ae
CONTACT_FROM_EMAIL=
# Where enquiries land. Defaults to info@rosica.ae when unset.
CONTACT_TO_EMAIL=info@rosica.ae


# The Rosica assistant (the chat widget).
#
# Optional. Without it the launcher never appears — the site is unchanged, no
# broken button. With it, /api/chat answers visitors from a brief built out of
# the site's own content, so it cannot invent product or ingredient claims.
#
# Get a key at https://console.anthropic.com and set a spend limit while you
# are there; the widget is open to anyone who loads the page.

ANTHROPIC_API_KEY=
